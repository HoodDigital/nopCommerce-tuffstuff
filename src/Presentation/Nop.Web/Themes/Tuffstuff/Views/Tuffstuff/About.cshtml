@{
    Layout = "_Root";

    //page class
    NopHtml.AppendPageCssClassParts("html-home-page");

    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/Themes/Tuffstuff/Content/lib/jquery-colorbox/query.colorbox-min.js");
    NopHtml.AddCssFileParts("~/Themes/Tuffstuff/Content/lib/jquery-colorbox/example4/colorbox.css");

}
<div class="">
    <section class="large-padded top-fade">
        <div class="section-bg" style="background-image:url(/Themes/Tuffstuff/Content/images/new/accessories.jpg)"></div>
        <div class="container">
            <div class="row">
                <div class="col-sm-8 col-sm-offset-2 text-center m-b-lg">
                    <h4>
                        About TuffStuff
                    </h4>
                    <p>
                        We are Nige &amp; Jacqui McWhinney and are based in Nottingham, England. All our leads and collars are manufactured here and our embroidery is done in house, ensuring a reliable but speedy service.
                    </p>
                    <p>
                        We have had a trade stand at agility shows around the country through the summer season for over 20 years. Here you can visit us and see for yourself our quality products.
                    </p>
                </div>
            </div>
            <div class="categories">
                <div class="categories">
                    <div class="category-grid">
                        <div class="item-grid">
                            <div class="item-box">
                                <div class="category-item">
                                    <div class="picture no-colour">
                                        <a title="About Tuffstuff"
                                           style="background-image:url(/Themes/Tuffstuff/Content/images/jump-dogs.jpg)"
                                           href="/Themes/Tuffstuff/Content/images/jump-dogs.jpg"
                                           class="colorbox">
                                            <img alt="About Tuffstuff" src="/Themes/Tuffstuff/Content/images/jump-dogs.jpg" title="About Tuffstuff">
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="item-box">
                                <div class="category-item">
                                    <div class="picture no-colour">
                                        <a title="About Tuffstuff"
                                           style="background-image:url(/Themes/Tuffstuff/Content/images/new/about/aboutus.jpg)"
                                           href="/Themes/Tuffstuff/Content/images/new/about/aboutus.jpg"
                                           class="colorbox">
                                            <img alt="About Tuffstuff" src="/Themes/Tuffstuff/Content/images/new/about/aboutus.jpg" title="About Tuffstuff">
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="item-box">
                                <div class="category-item">
                                    <div class="picture no-colour">
                                        <a title="About Tuffstuff"
                                           style="background-image:url(/Themes/Tuffstuff/Content/images/new/about/chase4.jpg)"
                                           href="/Themes/Tuffstuff/Content/images/new/about/chase4.jpg"
                                           class="colorbox">
                                            <img alt="About Tuffstuff" src="/Themes/Tuffstuff/Content/images/new/about/chase4.jpg" title="About Tuffstuff">
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-8 col-sm-offset-2 text-center m-t-lg">
                    <h4>
                        Where it all began...
                    </h4>
                    <p>
                        Storm was Jacqui's first agility dog. We had been embroidering horse lead reins for many years for other companies. One day in 1999 I made Storm a lead, embroidered his name on it and took it to the club that I was then training with. The response was crazy, <strong>EVERYONE</strong> wanted a dog lead with their name on it.
                    </p>
                    <p>
                        So we started a new company up, called TuffStuff. The first year we did 2 shows with just leads, it proved so popular that the following year we found ourselves with a variety of leads and now collars, travelling around the country attending various shows with our trade stand.
                    </p>
                    <p>
                        20 years on, and TuffStuff is thriving. We pride ourselves on quality and customer service.
                    </p>
                    <p>
                        <strong>We have always had Border Collies, here are some of our very special dogs from past and present.</strong>
                    </p>
                </div>
            </div>
        </div>
    </section>
</div>

