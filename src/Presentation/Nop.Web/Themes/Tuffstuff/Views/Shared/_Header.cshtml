<div class="header">
    @await Component.InvokeAsync("AdminHeaderLinks")
    @await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.HeaderBefore })
    @await Component.InvokeAsync("HeaderLinks")
    @await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.HeaderMiddle })
    <div class="header-cart">
        <div class="container">
            @await Component.InvokeAsync("FlyoutShoppingCart")
        </div>
    </div>
    <div class="header-brand container">
        <button class="hamburger elastic mobile-menu-trigger" type="button" aria-label="Menu" aria-controls="mobile-menu">
            <span class="hamburger-box">
                <span class="hamburger-inner"></span>
            </span>
        </button>
        <div class="header-logo">
            @await Component.InvokeAsync("Logo")
        </div>
    </div>
    <div class="header-lower">
        <div class="container">
            <nav class="main">
                @{ await Html.RenderPartialAsync("_NavLinks"); }
            </nav>
        </div>
    </div>
    @await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.HeaderAfter })
    <nav class="mobile">
        <h4>
            <img title="Tuffstuff" alt="Tuffstuff" src="/Themes/Tuffstuff/Content/images/logo.jpg">
        </h4>
        <ul class="nav navbar-nav">
            <li><a href="/">Home</a></li>
            <li><a href="/leads">Leads</a></li>
            <li><a href="/specialised-leads-2">Specialised Leads</a></li>
            <li><a href="/collars">Collars</a></li>
            <li><a href="/other-items">Other Items</a></li>
            <li><a href="/shows">Our Shows</a></li>
            <li><a asp-action="About" asp-controller="Tuffstuff" class="ico-account">About Us</a></li>
            <li><a asp-action="ContactUs" asp-controller="Common" class="ico-account">Contact Us</a></li>
        </ul>
    </nav>
    <script asp-location="Footer">
        $('body').on('click', '.mobile-menu-trigger', function () {
            $('body').toggleClass('mobile-menu-open');
        });
    </script>
</div>
