@model MiniShoppingCartModel
<div id="topcartlink">
    <a href="@Url.RouteUrl("ShoppingCart")" class="ico-cart">
        <strong class="cart-label">Your Shopping Cart</strong><br />
        <span class="cart-qty"><i class="fa fa-shopping-cart m-r-xs"></i> @Model.SubTotal @string.Format("({0} item{1})", Model.TotalProducts, (Model.TotalProducts > 1 || Model.TotalProducts == 0) ? "s" : "")</span>
    </a>
</div>
